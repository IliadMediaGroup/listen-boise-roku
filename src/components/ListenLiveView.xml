<?xml version="1.0" encoding="utf-8" ?>
<component name="ListenLiveView" extends="Group">
    <interface>
        <field id="stations" type="array" />
        <field id="selectedStationIndex" type="int" />
        <field id="artist" type="string" />
        <field id="songTitle" type="string" />
        <field id="songHistory" type="array" />
    </interface>
    <children>
        <PosterGrid
            id="stationGrid"
            visible="true"
            numColumns="4"
            itemSize="[150, 150]"
            itemSpacing="[20, 20]"
            translation="[60, 50]"
            focusable="true" />
        <Group id="playbackUI" visible="false">
            <Poster
                id="albumCoverPoster"
                width="200"
                height="200"
                translation="[60, 50]"
                visible="true" />
            <Label
                id="stationLabel"
                width="600"
                height="40"
                translation="[280, 50]"
                visible="true">
                <Font id="font" size="30" uri="pkg:/fonts/Roboto-Regular.ttf" />
            </Label>
            <Label
                id="artistLabel"
                width="600"
                height="40"
                translation="[280, 100]"
                visible="true">
                <Font id="font" size="24" uri="pkg:/fonts/Roboto-Regular.ttf" />
            </Label>
            <Label
                id="songLabel"
                width="600"
                height="40"
                translation="[280, 140]"
                visible="true">
                <Font id="font" size="24" uri="pkg:/fonts/Roboto-Regular.ttf" />
            </Label>
            <Button
                id="toggleButton"
                text="Play/Pause"
                translation="[280, 190]"
                focusable="true"
                visible="true" />
            <PosterGrid
                id="historyList"
                numColumns="1"
                itemSize="[600, 40]"
                itemSpacing="[0, 10]"
                translation="[280, 250]"
                visible="true"
                focusable="true" />
        </Group>
    </children>
</component>